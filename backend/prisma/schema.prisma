generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  PLOT
  VILLA
  MIXED
}

enum Role {
  OWNER
  SUPER_ADMIN
  PLATFORM_ADMIN
  ADMIN
  MANAGER
  AGENT
  CHANNEL_PARTNER
  // BROKER is the legacy name for CHANNEL_PARTNER. Kept here so any stale
  // SQL/code referencing it still parses; new code must use CHANNEL_PARTNER.
  BROKER
}

enum ChannelPartnerStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum LeadVisibility {
  FULL
  PARTIAL
  ANONYMOUS
}

enum CompanyType {
  DEVELOPER
  BROKERAGE
  CHANNEL_PARTNER
  INDIVIDUAL
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
}

enum IntegrationProvider {
  META
  GOOGLE_ADS
  WEBSITE_FORM
  JUSTDIAL
  INDIAMART
}

enum IntegrationStatus {
  ACTIVE
  INVALID
  EXPIRED
  REVOKED
}

model Company {
  id                  String       @id @default(cuid())
  name                String
  type                CompanyType?
  email               String?
  phone               String?
  address             String?
  logoUrl             String?
  brandColor          String?
  timezone            String?      @default("Asia/Kolkata")
  currency            String?      @default("INR")
  subscriptionPlan    String?      @default("BASIC")
  // Plan the owner selected from the pricing page at signup, before paying.
  // Stays set until Razorpay confirms checkout and subscriptionPlan is bumped.
  pendingPlan         String?
  pendingBillingCycle String?
  // When the BASIC plan trial ends. Set to createdAt + 7 days for new
  // signups. planGate.assertTrialActive() throws 402 TRIAL_EXPIRED when
  // the company is still on BASIC after this timestamp.
  trialEndsAt         DateTime?
  onboardingCompleted Boolean      @default(false)
  status              String?      @default("ACTIVE")
  city                String?
  intakeTokens        Json?
  // Per-tenant SMTP — optional. When set, outgoing tenant mail (invites,
  // etc.) uses this server instead of the platform .env SMTP. smtpPassEnc
  // is AES-256-GCM ciphertext via integrations/crypto.js (v1: prefix).
  smtpHost            String?
  smtpPort            Int?
  smtpSecure          Boolean      @default(false)
  smtpUser            String?
  smtpPassEnc         String?
  smtpFromEmail       String?
  smtpFromName        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users                  User[]
  leads                  Lead[]
  projects               Project[]
  tasks                  Task[]
  pipelineStages         PipelineStage[]
  activities             Activity[]
  notes                  Note[]
  invites                Invite[]
  audits                 PlatformAudit[]
  files                  File[]
  channelPartners        CompanyChannelPartner[]
  channelPartnerShares   ChannelPartnerShare[]
  integrations    IntegrationCredential[]
  subscriptions   Subscription[]
  payments        Payment[]
  followUps       FollowUp[]
  emailTemplates  EmailTemplate[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  provider      String    @default("CREDENTIAL")
  providerId    String?
  role          Role      @default(OWNER)
  phone         String?
  dept          String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  // Soft-delete marker. User rows are kept for FK integrity (audit logs,
  // lead ownership) — lookups filter via `where: { deletedAt: null }`.
  // Migration: 20260518000000_add_user_deleted_at.
  deletedAt     DateTime?
  companyId     String?
  invitedById   String?
  // For CHANNEL_PARTNER users (companyId is always null): the last
  // company they switched to in the dashboard. Used by the FE to default
  // the Switch Company dropdown back to the same place after refresh.
  defaultCompanyId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company         Company?        @relation(fields: [companyId], references: [id])
  invitedBy       User?           @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]          @relation("UserInvites")
  invitesSent     Invite[]        @relation("InvitesSent")
  leads           Lead[]          @relation("AssignedLeads")
  createdLeads    Lead[]          @relation("CreatedLeads")
  tasks           Task[]
  sessions        Session[]
  accounts        Account[]
  activities      Activity[]
  notes           Note[]
  notifications   Notification[]
  audits          PlatformAudit[]
  files           File[]          @relation("UploadedFiles")
  followUpsCreated   FollowUp[]   @relation("FollowUpCreatedBy")
  followUpsCompleted FollowUp[]   @relation("FollowUpCompletedBy")
  channelPartnerships    CompanyChannelPartner[]
  channelPartnerShares   ChannelPartnerShare[]   @relation("ChannelPartnerShares")
  emailTemplatesCreated  EmailTemplate[]         @relation("EmailTemplateCreatedBy")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  invitedById String
  invitedBy   User      @relation("InvitesSent", fields: [invitedById], references: [id])
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

// Channel Partner ↔ Company link. Replaces the legacy BrokerCompany table —
// one channel partner can collaborate with many companies, one company can
// invite many channel partners. INVITED → ACTIVE on accept; REVOKED is a
// soft kill (kept for audit). joinedAt mirrors acceptedAt but is the field
// callers should use when ordering / showing tenure.
model CompanyChannelPartner {
  id               String               @id @default(cuid())
  channelPartnerId String
  companyId        String
  status           ChannelPartnerStatus @default(INVITED)
  invitedAt        DateTime             @default(now())
  acceptedAt       DateTime?
  joinedAt         DateTime?
  revokedAt        DateTime?

  channelPartner User    @relation(fields: [channelPartnerId], references: [id], onDelete: Cascade)
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([channelPartnerId, companyId])
  @@index([companyId])
  @@index([channelPartnerId])
}

// One Lead can be shared by a Channel Partner across multiple companies
// at the same time. Each share row represents the lead's visibility to
// a specific company. Visibility is configurable per share so a CP can
// give Company A full details and Company B only the masked phone.
model ChannelPartnerShare {
  id               String         @id @default(cuid())
  leadId           String
  companyId        String
  channelPartnerId String
  visibility       LeadVisibility @default(FULL)
  // Status mirrors the lifecycle the CP and company go through on this
  // share — a CP can withdraw a share for one company without affecting
  // the others; the company-side won't see the lead any more.
  status           ChannelPartnerStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  revokedAt        DateTime?

  lead           Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channelPartner User    @relation("ChannelPartnerShares", fields: [channelPartnerId], references: [id], onDelete: Cascade)

  @@unique([leadId, companyId])
  @@index([companyId])
  @@index([channelPartnerId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id                  String    @id @default(cuid())
  name                String
  phone               String
  email               String?
  source              String?
  budget              String?
  status              String    @default("New")
  requirementType     String?
  assignedToId        String?
  createdById         String?
  // Nullable so Channel Partners can capture a lead in their private pool
  // before deciding which company (if any) to share it with. Tenant-scoped
  // queries already filter by companyId via tenantPrisma, so null-companyId
  // rows are invisible to the company side until the CP shares them.
  companyId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  city                String?
  interestedProjectId String?
  score               Int?
  priority            String?
  possessionTimeline  String?
  tags                String[]
  lastContactedAt     DateTime?
  nextFollowUpAt      DateTime?
  // Visibility level applied when this lead is rendered for a non-tenant
  // viewer (today: the Channel Partner who didn't create it). FULL shows
  // everything, PARTIAL masks phone/email, ANONYMOUS masks name too.
  // Defaults to FULL so existing leads are unaffected.
  visibility          LeadVisibility @default(FULL)
  // When set, this lead was sourced by a Channel Partner. Used by the
  // Owner-side "Shared by Channel Partner" filter and CP private-leads view.
  channelPartnerId    String?
  // Soft-delete timestamp. When non-null, the lead is in the 30-day
  // recovery window — hidden from every default listing but recoverable
  // from the Trash view. A background job hard-deletes leads where
  // deletedAt < now - 30 days. Permanent (hard) deletes never touch this
  // column — they remove the row outright.
  deletedAt           DateTime?

  assignedTo        User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy         User?      @relation("CreatedLeads", fields: [createdById], references: [id])
  interestedProject Project?   @relation(fields: [interestedProjectId], references: [id])
  company           Company?   @relation(fields: [companyId], references: [id])
  activities        Activity[]
  notes             Note[]
  tasks             Task[]
  files             File[]
  followUps         FollowUp[]
  channelPartnerShares ChannelPartnerShare[]
}

model FollowUp {
  id            String    @id @default(cuid())
  companyId     String
  leadId        String
  scheduledAt   DateTime
  completedAt   DateTime?
  outcome       String?
  notes         String?
  createdById   String?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  lead        Lead    @relation(fields: [leadId], references: [id])
  createdBy   User?   @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  completedBy User?   @relation("FollowUpCompletedBy", fields: [completedById], references: [id])

  @@index([companyId, scheduledAt])
  @@index([leadId, scheduledAt])
}

// Tenant-managed email templates. The "Send Email" panel on a lead lets
// the user pick a template or compose from scratch; the email is then
// rendered with lead variables ({{lead.name}} etc.) and sent through the
// company's configured SMTP. Templates are scoped per tenant.
model EmailTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  subject     String
  body        String   // plain text or basic HTML — rendered as-is in the email
  category    String?  // optional grouping: "Welcome", "Follow-up", "Site Visit", etc.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([companyId])
}

model Project {
  id             String      @id @default(cuid())
  name           String
  location       String
  type           ProjectType
  priceRange     String?
  companyId      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  coverImageUrl  String?
  description    String?
  reraNumber     String?
  possessionDate DateTime?


  company Company @relation(fields: [companyId], references: [id])
  leads   Lead[]
  tasks   Task[]
  files   File[]
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("PENDING")
  dueAt        DateTime?
  assignedToId String?
  companyId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  leadId       String?
  projectId    String?

  assignedTo User?    @relation(fields: [assignedToId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])
}

model PipelineStage {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  order       Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  leadId    String?
  userId    String?
  type      ActivityType
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead?   @relation(fields: [leadId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  leadId    String
  userId    String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String // LEAD_ASSIGNED | LEAD_STATUS_CHANGED | NOTE_MENTION | SYSTEM | etc.
  title     String
  body      String?
  link      String? // e.g. /leads/<id>

  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PlatformAudit {
  id        String   @id @default(cuid())
  // Nullable: a failed-login audit has no confirmed actor (the email
  // didn't match any user). Previously stored as "unknown" string which
  // violated the User FK and silently dropped the audit row.
  actorId   String?
  action    String // e.g. COMPANY_SUSPENDED, SUPER_ADMIN_LOGIN
  // Nullable because platform-wide events (super-admin login, system
  // jobs, etc.) have no specific company target. Previously required +
  // foreign-keyed, which caused login audits to silently fail on the
  // empty-string FK.
  targetId  String?

  metadata  Json?
  createdAt DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id])
  company Company? @relation(fields: [targetId], references: [id])

  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  source    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model IntegrationCredential {
  id             String              @id @default(cuid())
  companyId      String
  provider       IntegrationProvider
  label          String
  credentials    String
  webhookToken   String              @unique
  externalIds    String[]
  status         IntegrationStatus   @default(ACTIVE)
  lastVerifiedAt DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  expiresAt      DateTime?
  lastPolledAt   DateTime?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, label])
  @@index([provider])
  @@index([status])
}

model WebhookEvent {
  id           String              @id @default(cuid())
  provider     IntegrationProvider
  externalId   String
  credentialId String?
  receivedAt   DateTime            @default(now())
  processedAt  DateTime?
  status       String
  errorMessage String?
  rawPayload   Json

  @@unique([provider, externalId])
  @@index([credentialId, receivedAt])
}

model File {
  id              String    @id @default(cuid())
  companyId       String
  uploaderId      String
  folder          String    @default("general")
  name            String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  leadId          String?
  projectId       String?
  shareToken      String?   @unique
  shareExpiresAt  DateTime?
  createdAt       DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  lead     Lead?    @relation(fields: [leadId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])
  uploader User     @relation("UploadedFiles", fields: [uploaderId], references: [id])


  @@index([companyId, folder, createdAt])
  @@index([leadId])
  @@index([projectId])
}

// Subscription plan catalogue. Source of truth for prices, limits, and
// features — used to be hardcoded in lib/planLimits.js, now editable by
// SuperAdmin. planLimits.js still ships the same shape for FE fallback +
// helper functions; the BE reads exclusively from this table via planService.
//
// Razorpay plan IDs live here so the SuperAdmin UI can show "this plan
// is mapped to plan_xxxx in Razorpay". When the price changes, a NEW
// Razorpay plan is created (you can't mutate price on an existing one);
// the old IDs move into archivedRazorpayPlanIds so existing subscriptions
// (which reference the old plan_id) keep working until they renew.
model Plan {
  id                    String   @id @default(cuid())
  code                  String   @unique  // BASIC | PRO | ENTERPRISE
  name                  String
  tagline               String
  featured              Boolean  @default(false)
  sortOrder             Int      @default(100)
  // Prices in paise. BASIC has 0. For PRO/ENTERPRISE: priceMonthly is the
  // monthly billing amount; priceAnnual is the **per-month equivalent**
  // when billed annually (so the FE can render "₹1,999/mo billed yearly").
  priceMonthly          Int      @default(0)
  priceAnnual           Int      @default(0)
  trialDays             Int      @default(0)
  // Same shape as planLimits.js: { users, leads, projects, storageBytes, integrations }
  limits                Json
  // { customPipelineStages, leadAging, webhookIntake, byoIntegrations, duplicateDetection, agentPrivacy, auditLog }
  features              Json
  bullets               String[]
  support               String?
  onboarding            String?
  razorpayPlanIdMonthly String?
  razorpayPlanIdAnnual  String?
  // Archived Razorpay plan IDs from prior price changes. JSON array of
  // { id, billingCycle, archivedAt, replacedBy }. Existing subs still
  // reference these IDs in Razorpay; we don't delete them.
  archivedRazorpayPlanIds Json?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// One Subscription row per (Company, paid-plan) lifecycle. Created when the
// owner kicks off Razorpay Checkout; transitions ACTIVE/HALTED/CANCELLED via
// the Razorpay webhook. The active row drives Company.subscriptionPlan:
// the webhook sets plan = PRO/ENTERPRISE on activate, BASIC on cancel.
//
// We keep cancelled/expired rows so the FE billing page can show history.
model Subscription {
  id                      String   @id @default(cuid())
  companyId               String
  plan                    String   // "PRO" | "ENTERPRISE"
  billingCycle            String   // "monthly" | "annual"
  status                  String   // CREATED | ACTIVE | HALTED | CANCELLED | EXPIRED
  razorpayPlanId          String?
  razorpaySubscriptionId  String?  @unique
  razorpayCustomerId      String?
  amount                  Int      // paise (₹2,499 → 249900)
  currency                String   @default("INR")
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  payments Payment[]

  @@index([companyId, status])
  @@index([razorpaySubscriptionId])
}

// One Payment row per Razorpay payment event (subscription.charged /
// payment.captured). Drives the FE billing page's invoice history. Stays
// even after a Subscription is cancelled, so finance can reconcile.
model Payment {
  id                String   @id @default(cuid())
  companyId         String
  subscriptionId    String?
  razorpayPaymentId String   @unique
  razorpayOrderId   String?
  razorpayInvoiceId String?
  amount            Int      // paise
  currency          String   @default("INR")
  status            String   // captured | failed | refunded
  method            String?  // card | upi | netbanking | wallet
  description       String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId, createdAt])
}
