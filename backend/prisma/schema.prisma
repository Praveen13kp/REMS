generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  PLOT
  VILLA
  MIXED
}

enum Role {
  OWNER
  SUPER_ADMIN
  PLATFORM_ADMIN
  ADMIN
  MANAGER
  AGENT
  BROKER
}

enum BrokerCompanyStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum CompanyType {
  DEVELOPER
  BROKERAGE
  CHANNEL_PARTNER
  INDIVIDUAL
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
}

enum IntegrationProvider {
  META
  GOOGLE_ADS
  WEBSITE_FORM
  JUSTDIAL
  INDIAMART
}

enum IntegrationStatus {
  ACTIVE
  INVALID
  EXPIRED
  REVOKED
}

model Company {
  id                  String       @id @default(cuid())
  name                String
  type                CompanyType?
  email               String?
  phone               String?
  address             String?
  logoUrl             String?
  brandColor          String?
  timezone            String?      @default("Asia/Kolkata")
  currency            String?      @default("INR")
  subscriptionPlan    String?      @default("FREE_TRIAL")
  onboardingCompleted Boolean      @default(false)
  status              String?      @default("ACTIVE")
  city                String?
  intakeTokens        Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users           User[]
  leads           Lead[]
  projects        Project[]
  tasks           Task[]
  pipelineStages  PipelineStage[]
  activities      Activity[]
  notes           Note[]
  invites         Invite[]
  audits          PlatformAudit[]
  files           File[]
  brokerCompanies BrokerCompany[]
  integrations    IntegrationCredential[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(OWNER)
  phone         String?
  dept          String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  companyId     String?
  invitedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company         Company?        @relation(fields: [companyId], references: [id])
  invitedBy       User?           @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]          @relation("UserInvites")
  invitesSent     Invite[]        @relation("InvitesSent")
  leads           Lead[]          @relation("AssignedLeads")
  createdLeads    Lead[]          @relation("CreatedLeads")
  tasks           Task[]
  sessions        Session[]
  accounts        Account[]
  activities      Activity[]
  notes           Note[]
  notifications   Notification[]
  audits          PlatformAudit[]
  files           File[]          @relation("UploadedFiles")
  brokerCompanies BrokerCompany[]
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  role            Role            @default(OWNER)
  companyId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  emailVerified   Boolean         @default(false)
  image           String?
  invitedById     String?
  isActive        Boolean         @default(true)
  phone           String?
  dept            String?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  accounts        Account[]
  activities      Activity[]
  brokerCompanies BrokerCompany[]
  files           File[]          @relation("UploadedFiles")
  invitesSent     Invite[]        @relation("InvitesSent")
  leads           Lead[]          @relation("AssignedLeads")
  createdLeads    Lead[]          @relation("CreatedLeads")
  notes           Note[]
  notifications   Notification[]
  audits          PlatformAudit[]
  sessions        Session[]
  tasks           Task[]
  company         Company?        @relation(fields: [companyId], references: [id])
  invitedBy       User?           @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]          @relation("UserInvites")

  @@unique([companyId, email])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  companyId   String
  invitedById String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id])
  invitedBy   User      @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([companyId])
  @@index([email])
}

model BrokerCompany {
  id           String              @id @default(cuid())
  brokerUserId String
  companyId    String
  status       BrokerCompanyStatus @default(INVITED)
  invitedAt    DateTime            @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?

  broker  User    @relation(fields: [brokerUserId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  broker       User                @relation(fields: [brokerUserId], references: [id], onDelete: Cascade)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([brokerUserId, companyId])
  @@index([companyId])
  @@index([brokerUserId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id                  String    @id @default(cuid())
  id                  String     @id @default(cuid())
  name                String
  email               String?
  phone               String
  source              String?
  budget              String?
  status              String    @default("New")
  requirementType     String?
  assignedToId        String?
  companyId           String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  city                String?
  createdById         String?
  interestedProjectId String?
  lastContactedAt     DateTime?
  requirementType     String?
  score               Int?
  tags                String[]
  status              String     @default("New")
  priority            String?
  possessionTimeline  String?
  nextFollowUpAt      DateTime?
  assignedToId        String?
  createdById         String?
  companyId           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedTo        User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy         User?      @relation("CreatedLeads", fields: [createdById], references: [id])
  interestedProject Project?   @relation(fields: [interestedProjectId], references: [id])
  company           Company    @relation(fields: [companyId], references: [id])
  activities        Activity[]
  notes             Note[]
  tasks             Task[]
  files             File[]
  activities          Activity[]
  files               File[]
  assignedTo          User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  company             Company    @relation(fields: [companyId], references: [id])
  createdBy           User?      @relation("CreatedLeads", fields: [createdById], references: [id])
  interestedProject   Project?   @relation(fields: [interestedProjectId], references: [id])
  notes               Note[]
  tasks               Task[]
}

model Project {
  id             String      @id @default(cuid())
  name           String
  location       String
  priceRange     String?
  companyId      String
  createdAt      DateTime    @default(now())
  coverImageUrl  String?
  description    String?
  possessionDate DateTime?
  coverImageUrl  String?
  companyId      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  leads   Lead[]
  tasks   Task[]
  reraNumber     String?
  updatedAt      DateTime    @updatedAt
  type           ProjectType
  leads          Lead[]
  company        Company     @relation(fields: [companyId], references: [id])
  tasks          Task[]
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("PENDING")
  dueAt        DateTime?
  assignedToId String?
  companyId    String
  createdAt    DateTime  @default(now())
  dueAt        DateTime?
  leadId       String?
  projectId    String?
  companyId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo User?    @relation(fields: [assignedToId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])
  updatedAt    DateTime  @updatedAt
  status       String    @default("PENDING")
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  company      Company   @relation(fields: [companyId], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id])
  project      Project?  @relation(fields: [projectId], references: [id])
}

model PipelineStage {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  order       Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  leadId    String
  userId    String?
  type      ActivityType
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id])
  lead      Lead         @relation(fields: [leadId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  leadId    String
  userId    String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String // LEAD_ASSIGNED | LEAD_STATUS_CHANGED | NOTE_MENTION | SYSTEM | etc.
  title     String
  body      String?
  link      String? // e.g. /leads/<id>
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PlatformAudit {
  id        String   @id @default(cuid())
  actorId   String
  action    String // e.g. COMPANY_SUSPENDED
  action    String
  targetId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  company   Company  @relation(fields: [targetId], references: [id])

  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  source    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Per-tenant credentials for BYO lead-source integrations. The credentials
// blob is AES-256-GCM encrypted at rest (see modules/integrations/crypto.js)
// — never readable by Prisma queries. webhookToken is the opaque path
// segment used in /api/webhooks/{provider}/byo/{token} so we never trust
// payload-supplied identifiers for tenant routing.
model IntegrationCredential {
  id             String              @id @default(cuid())
  companyId      String
  provider       IntegrationProvider
  label          String
  credentials    String // encrypted JSON: v1:<iv>:<authTag>:<ciphertext>
  webhookToken   String              @unique
  externalIds    String[] // e.g. [pageId] for META, [customerId] for GOOGLE_ADS
  status         IntegrationStatus   @default(ACTIVE)
  lastVerifiedAt DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  expiresAt      DateTime?
  lastPolledAt   DateTime? // pull-based providers: sliding-window cursor
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, label])
  @@index([provider])
  @@index([status])
}

// Audit + idempotency trail for every inbound webhook. The unique
// (provider, externalId) constraint is what guarantees a retried delivery
// (Meta + Google both retry on non-2xx) never creates a duplicate lead.
model WebhookEvent {
  id           String              @id @default(cuid())
  provider     IntegrationProvider
  externalId   String // leadgen_id, UNIQUE_QUERY_ID, etc.
  credentialId String?
  receivedAt   DateTime            @default(now())
  processedAt  DateTime?
  status       String // RECEIVED | PROCESSED | FAILED | DUPLICATE
  errorMessage String?
  rawPayload   Json

  @@unique([provider, externalId])
  @@index([credentialId, receivedAt])
}

model File {
  id         String   @id @default(cuid())
  companyId  String
  uploaderId String
  folder     String   @default("general")
  name       String
  mimeType   String
  sizeBytes  Int
  storageKey String
  leadId     String?
  createdAt  DateTime @default(now())

  company  Company @relation(fields: [companyId], references: [id])
  uploader User    @relation("UploadedFiles", fields: [uploaderId], references: [id])
  lead     Lead?   @relation(fields: [leadId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])
  uploader   User     @relation("UploadedFiles", fields: [uploaderId], references: [id])

  @@index([companyId, folder, createdAt])
  @@index([leadId])
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  PLOT
  VILLA
  MIXED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
  OWNER
  PLATFORM_ADMIN
  BROKER
}

enum BrokerCompanyStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum CompanyType {
  DEVELOPER
  BROKERAGE
  CHANNEL_PARTNER
  INDIVIDUAL
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
}
