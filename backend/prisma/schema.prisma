generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  PLOT
  VILLA
  MIXED
}

enum Role {
  OWNER
  SUPER_ADMIN
  PLATFORM_ADMIN
  ADMIN
  MANAGER
  AGENT
  BROKER
}

enum BrokerCompanyStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum CompanyType {
  DEVELOPER
  BROKERAGE
  CHANNEL_PARTNER
  INDIVIDUAL
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
}

enum IntegrationProvider {
  META
  GOOGLE_ADS
  WEBSITE_FORM
  JUSTDIAL
  INDIAMART
}

enum IntegrationStatus {
  ACTIVE
  INVALID
  EXPIRED
  REVOKED
}

model Company {
  id                  String       @id @default(cuid())
  name                String
  type                CompanyType?
  email               String?
  phone               String?
  address             String?
  logoUrl             String?
  brandColor          String?
  timezone            String?      @default("Asia/Kolkata")
  currency            String?      @default("INR")
  subscriptionPlan    String?      @default("BASIC")
  // Plan the owner selected from the pricing page at signup, before paying.
  // Stays set until Razorpay confirms checkout and subscriptionPlan is bumped.
  pendingPlan         String?
  pendingBillingCycle String?
  // When the BASIC plan trial ends. Set to createdAt + 7 days for new
  // signups. planGate.assertTrialActive() throws 402 TRIAL_EXPIRED when
  // the company is still on BASIC after this timestamp.
  trialEndsAt         DateTime?
  onboardingCompleted Boolean      @default(false)
  status              String?      @default("ACTIVE")
  city                String?
  intakeTokens        Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users           User[]
  leads           Lead[]
  projects        Project[]
  tasks           Task[]
  pipelineStages  PipelineStage[]
  activities      Activity[]
  notes           Note[]
  invites         Invite[]
  audits          PlatformAudit[]
  files           File[]
  brokerCompanies BrokerCompany[]
  integrations    IntegrationCredential[]
  subscriptions   Subscription[]
  payments        Payment[]
  followUps       FollowUp[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(OWNER)
  phone         String?
  dept          String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  // Soft-delete marker. User rows are kept for FK integrity (audit logs,
  // lead ownership) — lookups filter via `where: { deletedAt: null }`.
  // Migration: 20260518000000_add_user_deleted_at.
  deletedAt     DateTime?
  companyId     String?
  invitedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company         Company?        @relation(fields: [companyId], references: [id])
  invitedBy       User?           @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]          @relation("UserInvites")
  invitesSent     Invite[]        @relation("InvitesSent")
  leads           Lead[]          @relation("AssignedLeads")
  createdLeads    Lead[]          @relation("CreatedLeads")
  tasks           Task[]
  sessions        Session[]
  accounts        Account[]
  activities      Activity[]
  notes           Note[]
  notifications   Notification[]
  audits          PlatformAudit[]
  files           File[]          @relation("UploadedFiles")
  followUpsCreated   FollowUp[]   @relation("FollowUpCreatedBy")
  followUpsCompleted FollowUp[]   @relation("FollowUpCompletedBy")
  brokerCompanies BrokerCompany[]
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  invitedById String
  invitedBy   User      @relation("InvitesSent", fields: [invitedById], references: [id])
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

model BrokerCompany {
  id           String              @id @default(cuid())
  brokerUserId String
  companyId    String
  status       BrokerCompanyStatus @default(INVITED)
  invitedAt    DateTime            @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?

  broker  User    @relation(fields: [brokerUserId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([brokerUserId, companyId])
  @@index([companyId])
  @@index([brokerUserId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id                  String    @id @default(cuid())
  name                String
  phone               String
  email               String?
  source              String?
  budget              String?
  status              String    @default("New")
  requirementType     String?
  assignedToId        String?
  createdById         String?
  companyId           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  city                String?
  interestedProjectId String?
  score               Int?
  priority            String?
  possessionTimeline  String?
  tags                String[]
  lastContactedAt     DateTime?
  nextFollowUpAt      DateTime?

  assignedTo        User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy         User?      @relation("CreatedLeads", fields: [createdById], references: [id])
  interestedProject Project?   @relation(fields: [interestedProjectId], references: [id])
  company           Company    @relation(fields: [companyId], references: [id])
  activities        Activity[]
  notes             Note[]
  tasks             Task[]
  files             File[]
  followUps         FollowUp[]
}

model FollowUp {
  id            String    @id @default(cuid())
  companyId     String
  leadId        String
  scheduledAt   DateTime
  completedAt   DateTime?
  outcome       String?
  notes         String?
  createdById   String?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  lead        Lead    @relation(fields: [leadId], references: [id])
  createdBy   User?   @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  completedBy User?   @relation("FollowUpCompletedBy", fields: [completedById], references: [id])

  @@index([companyId, scheduledAt])
  @@index([leadId, scheduledAt])
}

model Project {
  id             String      @id @default(cuid())
  name           String
  location       String
  type           ProjectType
  priceRange     String?
  companyId      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  coverImageUrl  String?
  description    String?
  reraNumber     String?
  possessionDate DateTime?


  company Company @relation(fields: [companyId], references: [id])
  leads   Lead[]
  tasks   Task[]
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("PENDING")
  dueAt        DateTime?
  assignedToId String?
  companyId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  leadId       String?
  projectId    String?

  assignedTo User?    @relation(fields: [assignedToId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])
}

model PipelineStage {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  order       Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  leadId    String?
  userId    String?
  type      ActivityType
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead?   @relation(fields: [leadId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  leadId    String
  userId    String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String // LEAD_ASSIGNED | LEAD_STATUS_CHANGED | NOTE_MENTION | SYSTEM | etc.
  title     String
  body      String?
  link      String? // e.g. /leads/<id>

  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PlatformAudit {
  id        String   @id @default(cuid())
  // Nullable: a failed-login audit has no confirmed actor (the email
  // didn't match any user). Previously stored as "unknown" string which
  // violated the User FK and silently dropped the audit row.
  actorId   String?
  action    String // e.g. COMPANY_SUSPENDED, SUPER_ADMIN_LOGIN
  // Nullable because platform-wide events (super-admin login, system
  // jobs, etc.) have no specific company target. Previously required +
  // foreign-keyed, which caused login audits to silently fail on the
  // empty-string FK.
  targetId  String?

  metadata  Json?
  createdAt DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id])
  company Company? @relation(fields: [targetId], references: [id])

  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  source    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model IntegrationCredential {
  id             String              @id @default(cuid())
  companyId      String
  provider       IntegrationProvider
  label          String
  credentials    String
  webhookToken   String              @unique
  externalIds    String[]
  status         IntegrationStatus   @default(ACTIVE)
  lastVerifiedAt DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  expiresAt      DateTime?
  lastPolledAt   DateTime?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, label])
  @@index([provider])
  @@index([status])
}

model WebhookEvent {
  id           String              @id @default(cuid())
  provider     IntegrationProvider
  externalId   String
  credentialId String?
  receivedAt   DateTime            @default(now())
  processedAt  DateTime?
  status       String
  errorMessage String?
  rawPayload   Json

  @@unique([provider, externalId])
  @@index([credentialId, receivedAt])
}

model File {
  id         String   @id @default(cuid())
  companyId  String
  uploaderId String
  folder     String   @default("general")
  name       String
  mimeType   String
  sizeBytes  Int
  storageKey String
  leadId     String?
  createdAt  DateTime @default(now())

  company  Company @relation(fields: [companyId], references: [id])
  lead     Lead?   @relation(fields: [leadId], references: [id])
  uploader User    @relation("UploadedFiles", fields: [uploaderId], references: [id])


  @@index([companyId, folder, createdAt])
  @@index([leadId])
}

// Subscription plan catalogue. Source of truth for prices, limits, and
// features — used to be hardcoded in lib/planLimits.js, now editable by
// SuperAdmin. planLimits.js still ships the same shape for FE fallback +
// helper functions; the BE reads exclusively from this table via planService.
//
// Razorpay plan IDs live here so the SuperAdmin UI can show "this plan
// is mapped to plan_xxxx in Razorpay". When the price changes, a NEW
// Razorpay plan is created (you can't mutate price on an existing one);
// the old IDs move into archivedRazorpayPlanIds so existing subscriptions
// (which reference the old plan_id) keep working until they renew.
model Plan {
  id                    String   @id @default(cuid())
  code                  String   @unique  // BASIC | PRO | ENTERPRISE
  name                  String
  tagline               String
  featured              Boolean  @default(false)
  sortOrder             Int      @default(100)
  // Prices in paise. BASIC has 0. For PRO/ENTERPRISE: priceMonthly is the
  // monthly billing amount; priceAnnual is the **per-month equivalent**
  // when billed annually (so the FE can render "₹1,999/mo billed yearly").
  priceMonthly          Int      @default(0)
  priceAnnual           Int      @default(0)
  trialDays             Int      @default(0)
  // Same shape as planLimits.js: { users, leads, projects, storageBytes, integrations }
  limits                Json
  // { customPipelineStages, leadAging, webhookIntake, byoIntegrations, duplicateDetection, agentPrivacy, auditLog }
  features              Json
  bullets               String[]
  support               String?
  onboarding            String?
  razorpayPlanIdMonthly String?
  razorpayPlanIdAnnual  String?
  // Archived Razorpay plan IDs from prior price changes. JSON array of
  // { id, billingCycle, archivedAt, replacedBy }. Existing subs still
  // reference these IDs in Razorpay; we don't delete them.
  archivedRazorpayPlanIds Json?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// One Subscription row per (Company, paid-plan) lifecycle. Created when the
// owner kicks off Razorpay Checkout; transitions ACTIVE/HALTED/CANCELLED via
// the Razorpay webhook. The active row drives Company.subscriptionPlan:
// the webhook sets plan = PRO/ENTERPRISE on activate, BASIC on cancel.
//
// We keep cancelled/expired rows so the FE billing page can show history.
model Subscription {
  id                      String   @id @default(cuid())
  companyId               String
  plan                    String   // "PRO" | "ENTERPRISE"
  billingCycle            String   // "monthly" | "annual"
  status                  String   // CREATED | ACTIVE | HALTED | CANCELLED | EXPIRED
  razorpayPlanId          String?
  razorpaySubscriptionId  String?  @unique
  razorpayCustomerId      String?
  amount                  Int      // paise (₹2,499 → 249900)
  currency                String   @default("INR")
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  payments Payment[]

  @@index([companyId, status])
  @@index([razorpaySubscriptionId])
}

// One Payment row per Razorpay payment event (subscription.charged /
// payment.captured). Drives the FE billing page's invoice history. Stays
// even after a Subscription is cancelled, so finance can reconcile.
model Payment {
  id                String   @id @default(cuid())
  companyId         String
  subscriptionId    String?
  razorpayPaymentId String   @unique
  razorpayOrderId   String?
  razorpayInvoiceId String?
  amount            Int      // paise
  currency          String   @default("INR")
  status            String   // captured | failed | refunded
  method            String?  // card | upi | netbanking | wallet
  description       String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId, createdAt])
}
